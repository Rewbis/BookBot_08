ANTHROPIC_API_KEY=your_key_here
TAVILY_API_KEY=your_key_here

# Which model runs the agents: claude (API) or ollama (local). The header toggle changes it at runtime
# and saves the choice to .bookbot_settings.json, which then takes precedence over this value.
LLM_PROVIDER=claude
# BOOKBOT_SETTINGS=.bookbot_settings.json   # where that runtime choice is stored (optional)

# Generation model and context budget (defaults shown; all optional)
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_CONTEXT_WINDOW=1000000
# Absolute token count at which the context panel warns and offers compression.
# Deliberately not a % of the window: quality degrades gradually from the start, and cost bites first.
CONTEXT_WARN_TOKENS=120000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=richardyoung/qwen3-14b-abliterated:Q5_K_M
OLLAMA_NUM_CTX=16384
